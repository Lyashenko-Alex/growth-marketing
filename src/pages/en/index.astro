---
import Layout from '../../components/Layout.astro'; import PricingCards from '../../components/PricingCards.astro'; import GrowthVisual from '../../components/GrowthVisual.astro'; import ServiceIcon from '../../components/ServiceIcon.astro'; import LatestArticles from '../../components/LatestArticles.astro'; import AioSection from '../../components/AioSection.astro'; import { getCollection } from 'astro:content'; import { copy, siteConfig } from '../../config/site';
const locale='en' as const; const t=copy[locale]; const posts=(await getCollection('blog', ({data})=>!data.draft && data.language===locale)).sort((a,b)=>b.data.publicationDate.valueOf()-a.data.publicationDate.valueOf()); const schema={ '@context':'https://schema.org','@graph':[{'@type':'Organization',name:siteConfig.name,description:t.description,areaServed:['Slovenia','Europe'],url:siteConfig.productionUrl||undefined},{'@type':'WebSite',name:siteConfig.name,url:siteConfig.productionUrl||undefined}]};
---
<Layout {locale} title={t.title} description={t.description} path="/en/" schema={schema}>
<section class="hero hero-home"><div class="container hero-layout"><div class="hero-copy"><div class="eyebrow">GROWTH MARKETING AGENCY · SLOVENIA / EUROPE</div><h1>{t.hero.map((line, i)=><span class:list={{highlight:i===2}}>{line}</span>)}</h1><p>{t.heroText}</p><div class="actions"><a class="button green" href="/en/contact/">{t.freeAnalysis} <span aria-hidden="true">↗</span></a><a class="button secondary" href="/en/pricing/">{t.packages}</a></div><div class="hero-microcopy"><span class="micro-dot"></span>{t.heroMicrocopy}</div></div><GrowthVisual locale={locale} /></div><div class="container capability-strip"><span>SEO <b>&amp;</b> AIO</span><span>Performance Marketing</span><span>Analytics</span><span>Growth Strategy</span></div></section>
<section class="section dark"><div class="container"><div class="section-header"><div class="eyebrow">{t.methodologyLabel}</div><h2>{t.methodologyTitle}</h2><p class="muted">{t.methodologyText}</p></div><div class="grid numbered-grid">{t.methodology.map((item,i)=><article><div class="stage-number">0{i+1}</div><h3>{item.title}</h3><p class="muted">{item.text}</p></article>)}</div></div></section>
<section class="section services-section"><div class="container"><div class="section-header"><div class="eyebrow">{t.servicesLabel}</div><h2>{t.servicesTitle}</h2></div><div class="service-grid">{t.services.map((service, i)=><article class="service-item"><ServiceIcon kind={i} /><div><h3>{service.title}</h3><p>{service.text}</p></div></article>)}</div></div></section>
<AioSection locale={locale} />
<section class="section accent analysis-section"><div class="container"><div class="analysis-heading"><div><div class="eyebrow">04 / Free offer</div><h2>{t.analysisTitle}</h2></div><p>{t.analysisText}</p></div><div class="analysis-content"><ol class="deliverables">{t.analysisDeliverables.map((deliverable, i)=><li><span>{String(i+1).padStart(2,'0')}</span>{deliverable}</li>)}</ol><a class="button" href="/en/contact/">{t.analysisCta} <span aria-hidden="true">↗</span></a></div></div></section>
<section class="section pricing-section"><div class="container"><div class="section-header"><div class="eyebrow">05 / Pricing</div><h2>{t.pricingTitle}</h2></div><PricingCards locale={locale} /><p class="section-link"><a href="/en/pricing/">{t.pricingLink} <span aria-hidden="true">→</span></a></p></div></section>
{posts.length > 0 && <section class="section blog-section"><div class="container"><div class="section-header"><div class="eyebrow">06 / Blog</div><h2>{t.latest}</h2></div><LatestArticles posts={posts} locale={locale} /></div></section>}
<section class="section dark final-cta"><div class="container final-cta-inner"><div><div class="eyebrow">{posts.length > 0 ? '07' : '06'} / Next step</div><h2>{t.finalTitle}</h2><p class="muted">{t.finalText}</p></div><a class="button green" href="/en/contact/">{t.freeAnalysis} <span aria-hidden="true">↗</span></a></div></section>
</Layout>
