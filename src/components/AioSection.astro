---
import type { Locale } from '../config/site';
const { locale } = Astro.props as { locale: Locale };
const content = locale === 'sl' ? { label: '03 / Prihodnost iskanja', title: 'Bodite vidni tudi tam, kjer išče umetna inteligenca.', text: 'Način, kako ljudje iščejo informacije, izdelke in storitve, se spreminja. Optimiziramo vašo digitalno prisotnost za tradicionalne iskalnike in sisteme umetne inteligence.', seo: 'Izboljšujemo organsko vidnost vašega podjetja v tradicionalnih iskalnikih.', aio: 'Optimiziramo vsebino, strukturo in digitalno prisotnost vašega podjetja za boljšo prepoznavnost v odgovorih umetne inteligence.', cta: 'Preverite svojo digitalno vidnost', platforms: ['Google', 'ChatGPT', 'Gemini', 'Perplexity'] } : { label: '03 / The future of search', title: 'Be visible where AI searches.', text: 'The way people discover information, products and services is changing. We optimize your digital presence for both traditional search engines and AI-powered discovery.', seo: "Improve your business's organic visibility in traditional search engines.", aio: 'Optimize your content, structure and digital presence to improve discoverability in AI-generated answers.', cta: 'Assess your digital visibility', platforms: ['Google', 'ChatGPT', 'Gemini', 'Perplexity'] };
---
<section class="section aio-section"><div class="container"><div class="aio-intro"><div><div class="eyebrow">{content.label}</div><h2>{content.title}</h2></div><p>{content.text}</p></div><div class="platform-row" aria-label={locale === 'sl' ? 'Platforme za odkrivanje vsebine' : 'Content discovery platforms'}>{content.platforms.map((platform, i)=><span><i aria-hidden="true">{['G','◌','✦','P'][i]}</i>{platform}</span>)}</div><div class="aio-comparison"><article><div class="comparison-label">SEO</div><p>{content.seo}</p></article><article><div class="comparison-label">AIO / GEO</div><p>{content.aio}</p></article></div><a class="button green" href={locale === 'sl' ? '/kontakt/' : '/en/contact/'}>{content.cta} <span aria-hidden="true">↗</span></a></div></section>
