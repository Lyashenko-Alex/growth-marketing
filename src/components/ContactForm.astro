---
import type { Locale } from '../config/site';
const { locale } = Astro.props as { locale: Locale };
const text = locale === 'sl' ? { name:'Ime in priimek', company:'Ime podjetja', email:'Poslovni e-poštni naslov', website:'Spletno mesto', competitor:'Spletno mesto glavnega konkurenta (neobvezno)', info:'Dodatne informacije (neobvezno)' } : { name:'Name', company:'Company name', email:'Business email', website:'Website URL', competitor:'Main competitor website URL (optional)', info:'Additional information (optional)' };
---
<form class="form" onsubmit="return false"><div class="form-note">{locale === 'sl' ? 'Obrazec je v razvoju in trenutno ne pošilja podatkov.' : 'This form is in development and does not currently send data.'}</div><label for="name">{text.name} *</label><input id="name" name="name" required autocomplete="name" /><label for="company">{text.company} *</label><input id="company" name="company" required /><label for="email">{text.email} *</label><input id="email" name="email" type="email" required autocomplete="email" /><label for="website">{text.website} *</label><input id="website" name="website" type="url" required placeholder="https://" /><label for="competitor">{text.competitor}</label><input id="competitor" name="competitor" type="url" placeholder="https://" /><label for="info">{text.info}</label><textarea id="info" name="info"></textarea><label><input type="checkbox" required style="width:auto;margin-right:8px" /> {locale === 'sl' ? 'Strinjam se z obdelavo podatkov v skladu s politiko zasebnosti.' : 'I agree to the processing of my data according to the privacy policy.'} *</label><button class="button green" type="submit">{locale === 'sl' ? 'Pošlji povpraševanje' : 'Send enquiry'}</button></form>
